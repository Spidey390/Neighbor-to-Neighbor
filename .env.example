# Neighbor-to-Neighbor Environment Variables Configuration

# Application URL
APP_URL="http://localhost:3000"

# Firebase Cloud Firestore Configuration
FIREBASE_PROJECT_ID="neighbortoneighbor"
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# Groq LLM API Key (for Voice AI Request Parser)
GROQ_API_KEY="your_groq_api_key_here"

# Fast2SMS API Key (for Real 6-Digit OTP SMS Gateway to Indian Mobile Numbers)
FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# Cloudinary URL (for Identity Proof Document Storage)
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"